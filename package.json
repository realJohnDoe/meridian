{
  "name": "meridian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit && pnpm --filter meridian-oauth-worker run typecheck",
    "preview": "vite preview",
    "test": "vitest run && node --test \"scripts/*.test.mjs\" && pnpm --filter meridian-oauth-worker run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node --test \"scripts/*.test.mjs\" &&vitest run src/coverageConfig.test.ts && pnpm --filter meridian-oauth-worker run test:coverage",
    "lint": "eslint src worker/src e2e playwright.config.ts --max-warnings=0 && pnpm run lint:deps",
    "lint:deps": "depcruise src",
    "test:e2e": "playwright test",
    "knip": "knip",
    "check": "pnpm run build && pnpm run lint && pnpm run test:coverage && pnpm run knip"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-throttling": "^11.0.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.71.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "^0.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/router-plugin": "^1.169.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "apca-w3": "^0.1.9",
    "babel-plugin-react-compiler": "^1.0.0",
    "culori": "^4.0.2",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
