{
  "name": "meridian",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --noEmit && tsc -p tsconfig.test.json --noEmit && pnpm --filter meridian-oauth-worker run typecheck",
    "preview": "vite preview",
    "test": "vitest run && pnpm --filter meridian-oauth-worker run test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && vitest run src/coverageConfig.test.ts && pnpm --filter meridian-oauth-worker run test:coverage",
    "lint": "eslint src worker/src e2e playwright.config.ts --max-warnings=0 && pnpm run lint:deps",
    "lint:deps": "depcruise src",
    "test:e2e": "playwright test",
    "knip": "knip"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-throttling": "^11.0.5",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-virtual": "^3.14.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.7",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "yaml": "^2.9.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
